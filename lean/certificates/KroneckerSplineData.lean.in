module

public import ENT.Certificate.KroneckerSplineCore

/-! Integer coefficients and kernel-checked identities for the spline cells in this module. -/

set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option exponentiation.threshold 1000000

open ENT.Certificate
namespace ENT.Pilot.KroneckerSplineData

-- BEGIN CELL
private noncomputable def ${tag}Data : KroneckerLite.CellData where
  n := ${n}
  k := ${k}
  degreeBound := ${degree}
  halfCell := ${half}
  pCoeffs := [${pCoeffs}]
  rCoeffs := [${rCoeffs}]
  transformedCoeffs := [${transformedCoeffs}]
  bernsteinNumerators := [${bernsteinNumerators}]

private noncomputable def ${tag}PBase : Int := 2 ^ ${PBaseBits}
private noncomputable def ${tag}RBase : Int := 2 ^ ${RBaseBits}
private noncomputable def ${tag}BBase : Int := 2 ^ ${BBaseBits}

private theorem ${tag}_p_bound :
    KroneckerLite.sumAbs ${tag}Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound ${n} ${k} <
      ${tag}PBase.natAbs := by decide +kernel

private theorem ${tag}_p_eval :
    KroneckerLite.intEval ${tag}PBase ${tag}Data.pCoeffs =
      KroneckerSpline.canonicalEval ${n} ${k} ${tag}PBase := by
  decide +kernel

private theorem ${tag}_r_bound :
    KroneckerLite.sumAbs ${tag}Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound ${n} ${k}
        ${tag}Data.pCoeffs.length (KroneckerLite.sumAbs ${tag}Data.pCoeffs) <
      ${tag}RBase.natAbs := by decide +kernel

private theorem ${tag}_r_eval :
    KroneckerLite.intEval ${tag}RBase ${tag}Data.rCoeffs =
      KroneckerLite.curvatureEval ${n} ${k} ${tag}Data.pCoeffs ${tag}RBase := by
  decide +kernel


private theorem ${tag}_b_bound :
    KroneckerLite.sumAbs ${tag}Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound ${degree} ${tag}Data.bernsteinNumerators <
      ${tag}BBase.natAbs := by decide +kernel

private theorem ${tag}_b_eval :
    KroneckerLite.intEval ${tag}BBase ${tag}Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair ${tag}BBase ${tag}Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem ${tag}_valid : KroneckerSpline.Valid ${tag}Data ${tag}PBase ${tag}RBase ${tag}BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := ${tag}_p_bound
    p_eval := ${tag}_p_eval
    r_bound := ${tag}_r_bound
    r_eval := ${tag}_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := ${tag}_b_bound
    b_eval := ${tag}_b_eval
    nonneg := by decide +kernel
  }

public theorem ${tag}_exists : ∃ c : KroneckerLite.CellData,
    c.n = ${n} ∧ c.k = ${k} ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨${tag}Data, rfl, rfl, ${tag}PBase, ${tag}RBase, ${tag}BBase, ${tag}_valid⟩
-- END CELL
end ENT.Pilot.KroneckerSplineData
