module

public import ENT.Certificate.KroneckerDirectCore

/-! Integer coefficients and kernel-checked identities for the spline cells in this module. -/

set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option exponentiation.threshold 1000000

open ENT.Certificate
namespace ENT.Pilot.KroneckerDirectData

-- BEGIN CELL
private noncomputable def ${tag}Data : KroneckerDirect.CellData where
  n := ${n}
  k := ${k}
  degreeBound := ${degree}
  halfCell := ${half}
  pCoeffs := [${pCoeffs}]
  bernsteinNumerators := [${bernsteinNumerators}]

private noncomputable def ${tag}PBase : Int := 2 ^ ${PBaseBits}
private noncomputable def ${tag}U : Int := 2 ^ ${UBits}

private theorem ${tag}_p_bound :
    KroneckerLite.sumAbs ${tag}Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound ${n} ${k} <
      ${tag}PBase.natAbs := by decide +kernel

private theorem ${tag}_p_eval :
    KroneckerLite.intEval ${tag}PBase ${tag}Data.pCoeffs =
      KroneckerSpline.canonicalEval ${n} ${k} ${tag}PBase := by decide +kernel

private theorem ${tag}_b_bound :
    (${tag}Data.degreeBound + 1) * KroneckerDirect.qCoeffBound ${tag}Data +
      KroneckerLite.bernsteinCoeffBound ${degree} ${tag}Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase ${tag}Data ${tag}U).natAbs := by decide +kernel

private theorem ${tag}_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase ${tag}Data ${tag}U)
      ${tag}Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale ${tag}Data *
        KroneckerLite.curvatureEval ${n} ${k} ${tag}Data.pCoeffs ${tag}U := by
  decide +kernel

private theorem ${tag}_valid : KroneckerDirect.Valid ${tag}Data ${tag}PBase ${tag}U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := ${tag}_p_bound
    p_eval := ${tag}_p_eval
    b_length := by decide +kernel
    b_bound := ${tag}_b_bound
    direct_eval := ${tag}_direct_eval
    nonneg := by decide +kernel
  }

public theorem ${tag}_exists : ∃ c : KroneckerDirect.CellData,
    c.n = ${n} ∧ c.k = ${k} ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨${tag}Data, rfl, rfl, ${tag}PBase, ${tag}U, ${tag}_valid⟩
-- END CELL
end ENT.Pilot.KroneckerDirectData
