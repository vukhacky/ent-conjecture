def strongLangevinOperator (j : ℕ) : ℝ := if j < 8 then 1 else if j < 16 then 3 else 5

def strongLangevinChain (j : ℕ) (t : ℝ) : ℝ :=
  hyperbolicPoly 7 (strongLangevinP7 j) (strongLangevinQ7 j) t +
  hyperbolicPoly 5 (strongLangevinP5 j) (strongLangevinQ5 j) t +
  hyperbolicPoly 3 (strongLangevinP3 j) (strongLangevinQ3 j) t +
  hyperbolicPoly 1 (strongLangevinP1 j) (strongLangevinQ1 j) t

def strongLangevinFirst (j : ℕ) (t : ℝ) : ℝ :=
  hyperbolicPoly 7 ((strongLangevinP7 j).derivative + C 7 * strongLangevinQ7 j)
    ((strongLangevinQ7 j).derivative + C 7 * strongLangevinP7 j) t +
  hyperbolicPoly 5 ((strongLangevinP5 j).derivative + C 5 * strongLangevinQ5 j)
    ((strongLangevinQ5 j).derivative + C 5 * strongLangevinP5 j) t +
  hyperbolicPoly 3 ((strongLangevinP3 j).derivative + C 3 * strongLangevinQ3 j)
    ((strongLangevinQ3 j).derivative + C 3 * strongLangevinP3 j) t +
  hyperbolicPoly 1 ((strongLangevinP1 j).derivative + C 1 * strongLangevinQ1 j)
    ((strongLangevinQ1 j).derivative + C 1 * strongLangevinP1 j) t

theorem hasDerivAt_strongLangevinChain (j : ℕ) (t : ℝ) :
    HasDerivAt (strongLangevinChain j) (strongLangevinFirst j t) t :=
  (((hasDerivAt_hyperbolicPoly 7 (strongLangevinP7 j) (strongLangevinQ7 j) t).add
    (hasDerivAt_hyperbolicPoly 5 (strongLangevinP5 j) (strongLangevinQ5 j) t)).add
    (hasDerivAt_hyperbolicPoly 3 (strongLangevinP3 j) (strongLangevinQ3 j) t)).add
    (hasDerivAt_hyperbolicPoly 1 (strongLangevinP1 j) (strongLangevinQ1 j) t)

theorem hasDerivAt_strongLangevinFirst (j : Fin 24) (t : ℝ) :
    HasDerivAt (strongLangevinFirst j)
      (strongLangevinChain (j + 1 : ℕ) t + (strongLangevinOperator j)^2 * strongLangevinChain j t) t := by
  have h := (((hasDerivAt_hyperbolicPoly 7
    ((strongLangevinP7 j).derivative + C 7 * strongLangevinQ7 j)
    ((strongLangevinQ7 j).derivative + C 7 * strongLangevinP7 j) t).add
    (hasDerivAt_hyperbolicPoly 5
    ((strongLangevinP5 j).derivative + C 5 * strongLangevinQ5 j)
    ((strongLangevinQ5 j).derivative + C 5 * strongLangevinP5 j) t)).add
    (hasDerivAt_hyperbolicPoly 3
    ((strongLangevinP3 j).derivative + C 3 * strongLangevinQ3 j)
    ((strongLangevinQ3 j).derivative + C 3 * strongLangevinP3 j) t)).add
    (hasDerivAt_hyperbolicPoly 1
    ((strongLangevinP1 j).derivative + C 1 * strongLangevinQ1 j)
    ((strongLangevinQ1 j).derivative + C 1 * strongLangevinP1 j) t)
  apply h.congr_deriv
  fin_cases j <;>
    norm_num [strongLangevinChain, hyperbolicPoly, strongLangevinOperator,
      strongLangevinP7, strongLangevinQ7, strongLangevinP5, strongLangevinQ5,
      strongLangevinP3, strongLangevinQ3, strongLangevinP1, strongLangevinQ1,
      derivative_add, derivative_sub, derivative_mul, derivative_pow] <;> ring

theorem strongLangevinChain_zero (j : Fin 24) : strongLangevinChain j 0 = 0 := by
  fin_cases j <;>
    norm_num [strongLangevinChain, hyperbolicPoly,
      strongLangevinP7, strongLangevinQ7, strongLangevinP5, strongLangevinQ5,
      strongLangevinP3, strongLangevinQ3, strongLangevinP1, strongLangevinQ1]

theorem strongLangevinFirst_zero_nonneg (j : Fin 24) : 0 ≤ strongLangevinFirst j 0 := by
  fin_cases j <;>
    norm_num [strongLangevinFirst, hyperbolicPoly,
      strongLangevinP7, strongLangevinQ7, strongLangevinP5, strongLangevinQ5,
      strongLangevinP3, strongLangevinQ3, strongLangevinP1, strongLangevinQ1,
      derivative_add, derivative_sub, derivative_mul, derivative_pow]

theorem strongLangevinChain_terminal_pos {t : ℝ} (ht : 0 < t) : 0 < strongLangevinChain 24 t := by
  have hc := Real.cosh_pos (7*t)
  have hs := Real.sinh_pos_iff.mpr (by linarith : 0 < 7*t)
  norm_num [strongLangevinChain, hyperbolicPoly,
      strongLangevinP7, strongLangevinQ7, strongLangevinP5, strongLangevinQ5,
      strongLangevinP3, strongLangevinQ3, strongLangevinP1, strongLangevinQ1]
  positivity

theorem strongLangevinChain_pos_of_succ (j : Fin 24)
    (hpos : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain (j + 1 : ℕ) t)
    {t : ℝ} (ht : 0 < t) : 0 < strongLangevinChain j t := by
  apply positive_of_second_order_operator_of_nonneg_deriv (strongLangevinOperator j)
    (hasDerivAt_strongLangevinChain j) (hasDerivAt_strongLangevinFirst j)
    (strongLangevinChain_zero j) (strongLangevinFirst_zero_nonneg j) ?_ ht
  intro x hx
  nlinarith [hpos x hx]

theorem strongLangevinChain_pos {t : ℝ} (ht : 0 < t) : 0 < strongLangevinChain 0 t := by
  have h24 : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain 24 t :=
    fun _ ht => strongLangevinChain_terminal_pos ht
  have h23 : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain 23 t := fun _ ht =>
    strongLangevinChain_pos_of_succ ⟨23, by decide⟩ h24 ht
  have h22 : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain 22 t := fun _ ht =>
    strongLangevinChain_pos_of_succ ⟨22, by decide⟩ h23 ht
  have h21 : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain 21 t := fun _ ht =>
    strongLangevinChain_pos_of_succ ⟨21, by decide⟩ h22 ht
  have h20 : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain 20 t := fun _ ht =>
    strongLangevinChain_pos_of_succ ⟨20, by decide⟩ h21 ht
  have h19 : ∀ t : ℝ, 0 < t → 0 < strongLangevinChain 19 t := fun _ ht =>
