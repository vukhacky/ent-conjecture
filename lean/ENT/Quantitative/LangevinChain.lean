def langevinOperator (j : ℕ) : ℝ := if j < 8 then 1 else if j < 16 then 3 else 5

def langevinChain (j : ℕ) (t : ℝ) : ℝ :=
  hyperbolicPoly 7 (langevinP7 j) (langevinQ7 j) t +
  hyperbolicPoly 5 (langevinP5 j) (langevinQ5 j) t +
  hyperbolicPoly 3 (langevinP3 j) (langevinQ3 j) t +
  hyperbolicPoly 1 (langevinP1 j) (langevinQ1 j) t

def langevinFirst (j : ℕ) (t : ℝ) : ℝ :=
  hyperbolicPoly 7 ((langevinP7 j).derivative + C 7 * langevinQ7 j)
    ((langevinQ7 j).derivative + C 7 * langevinP7 j) t +
  hyperbolicPoly 5 ((langevinP5 j).derivative + C 5 * langevinQ5 j)
    ((langevinQ5 j).derivative + C 5 * langevinP5 j) t +
  hyperbolicPoly 3 ((langevinP3 j).derivative + C 3 * langevinQ3 j)
    ((langevinQ3 j).derivative + C 3 * langevinP3 j) t +
  hyperbolicPoly 1 ((langevinP1 j).derivative + C 1 * langevinQ1 j)
    ((langevinQ1 j).derivative + C 1 * langevinP1 j) t

theorem hasDerivAt_langevinChain (j : ℕ) (t : ℝ) :
    HasDerivAt (langevinChain j) (langevinFirst j t) t :=
  (((hasDerivAt_hyperbolicPoly 7 (langevinP7 j) (langevinQ7 j) t).add
    (hasDerivAt_hyperbolicPoly 5 (langevinP5 j) (langevinQ5 j) t)).add
    (hasDerivAt_hyperbolicPoly 3 (langevinP3 j) (langevinQ3 j) t)).add
    (hasDerivAt_hyperbolicPoly 1 (langevinP1 j) (langevinQ1 j) t)

theorem hasDerivAt_langevinFirst (j : Fin 24) (t : ℝ) :
    HasDerivAt (langevinFirst j)
      (langevinChain (j + 1 : ℕ) t + (langevinOperator j)^2 * langevinChain j t) t := by
  have h := (((hasDerivAt_hyperbolicPoly 7
    ((langevinP7 j).derivative + C 7 * langevinQ7 j)
    ((langevinQ7 j).derivative + C 7 * langevinP7 j) t).add
    (hasDerivAt_hyperbolicPoly 5
    ((langevinP5 j).derivative + C 5 * langevinQ5 j)
    ((langevinQ5 j).derivative + C 5 * langevinP5 j) t)).add
    (hasDerivAt_hyperbolicPoly 3
    ((langevinP3 j).derivative + C 3 * langevinQ3 j)
    ((langevinQ3 j).derivative + C 3 * langevinP3 j) t)).add
    (hasDerivAt_hyperbolicPoly 1
    ((langevinP1 j).derivative + C 1 * langevinQ1 j)
    ((langevinQ1 j).derivative + C 1 * langevinP1 j) t)
  apply h.congr_deriv
  fin_cases j <;>
    norm_num [langevinChain, hyperbolicPoly, langevinOperator,
      langevinP7, langevinQ7, langevinP5, langevinQ5,
      langevinP3, langevinQ3, langevinP1, langevinQ1,
      derivative_add, derivative_sub, derivative_mul, derivative_pow] <;> ring

theorem langevinChain_zero (j : Fin 24) : langevinChain j 0 = 0 := by
  fin_cases j <;>
    norm_num [langevinChain, hyperbolicPoly,
      langevinP7, langevinQ7, langevinP5, langevinQ5,
      langevinP3, langevinQ3, langevinP1, langevinQ1]

theorem langevinFirst_zero_nonneg (j : Fin 24) : 0 ≤ langevinFirst j 0 := by
  fin_cases j <;>
    norm_num [langevinFirst, hyperbolicPoly,
      langevinP7, langevinQ7, langevinP5, langevinQ5,
      langevinP3, langevinQ3, langevinP1, langevinQ1,
      derivative_add, derivative_sub, derivative_mul, derivative_pow]

theorem langevinChain_terminal_pos {t : ℝ} (ht : 0 < t) : 0 < langevinChain 24 t := by
  have hc := Real.cosh_pos (7*t)
  have hs := Real.sinh_pos_iff.mpr (by linarith : 0 < 7*t)
  norm_num [langevinChain, hyperbolicPoly,
      langevinP7, langevinQ7, langevinP5, langevinQ5,
      langevinP3, langevinQ3, langevinP1, langevinQ1]
  positivity

theorem langevinChain_pos_of_succ (j : Fin 24)
    (hpos : ∀ t : ℝ, 0 < t → 0 < langevinChain (j + 1 : ℕ) t)
    {t : ℝ} (ht : 0 < t) : 0 < langevinChain j t := by
  apply positive_of_second_order_operator_of_nonneg_deriv (langevinOperator j)
    (hasDerivAt_langevinChain j) (hasDerivAt_langevinFirst j)
    (langevinChain_zero j) (langevinFirst_zero_nonneg j) ?_ ht
  intro x hx
  nlinarith [hpos x hx]

theorem langevinChain_pos {t : ℝ} (ht : 0 < t) : 0 < langevinChain 0 t := by
  have h24 : ∀ t : ℝ, 0 < t → 0 < langevinChain 24 t :=
    fun _ ht => langevinChain_terminal_pos ht
  have h23 : ∀ t : ℝ, 0 < t → 0 < langevinChain 23 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨23, by decide⟩ h24 ht
  have h22 : ∀ t : ℝ, 0 < t → 0 < langevinChain 22 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨22, by decide⟩ h23 ht
  have h21 : ∀ t : ℝ, 0 < t → 0 < langevinChain 21 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨21, by decide⟩ h22 ht
  have h20 : ∀ t : ℝ, 0 < t → 0 < langevinChain 20 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨20, by decide⟩ h21 ht
  have h19 : ∀ t : ℝ, 0 < t → 0 < langevinChain 19 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨19, by decide⟩ h20 ht
  have h18 : ∀ t : ℝ, 0 < t → 0 < langevinChain 18 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨18, by decide⟩ h19 ht
  have h17 : ∀ t : ℝ, 0 < t → 0 < langevinChain 17 t := fun _ ht =>
    langevinChain_pos_of_succ ⟨17, by decide⟩ h18 ht
  have h16 : ∀ t : ℝ, 0 < t → 0 < langevinChain 16 t := fun _ ht =>
