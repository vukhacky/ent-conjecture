private noncomputable def n36k17RBase : ℤ := 2 ^ 440
private noncomputable def n36k17BBase : ℤ := 2 ^ 609

private theorem n36k17_spline : n36k17Data.pCoeffs =
    PureFast.fastSplineCoeffs 36 17 := by decide +kernel

private theorem n36k17_r_bound :
    Kronecker.sumAbs n36k17Data.rCoeffs +
      Kronecker.curvatureCoeffBound 36 17
        n36k17Data.pCoeffs.length (Kronecker.sumAbs n36k17Data.pCoeffs) <
      n36k17RBase.natAbs := by decide +kernel

private theorem n36k17_r_eval :
    Kronecker.intEval n36k17RBase n36k17Data.rCoeffs =
      Kronecker.curvatureEval 36 17 n36k17Data.pCoeffs n36k17RBase := by
  decide +kernel


private theorem n36k17_b_bound :
    Kronecker.sumAbs n36k17Data.transformedCoeffs +
      Kronecker.bernsteinCoeffBound 106 n36k17Data.bernsteinNumerators <
      n36k17BBase.natAbs := by decide +kernel

private theorem n36k17_b_eval :
    Kronecker.intEval n36k17BBase n36k17Data.transformedCoeffs =
      (Kronecker.bernsteinEvalPair n36k17BBase n36k17Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n36k17_valid : Kronecker.Valid n36k17Data n36k17RBase n36k17BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n36k17_spline
    r_bound := n36k17_r_bound
    r_eval := n36k17_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n36k17_b_bound
    b_eval := n36k17_b_eval
    nonneg := by decide +kernel
  }

