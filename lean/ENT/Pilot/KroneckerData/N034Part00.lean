private noncomputable def n34k8RBase : ℤ := 2 ^ 357
private noncomputable def n34k8BBase : ℤ := 2 ^ 515

private theorem n34k8_spline : n34k8Data.pCoeffs =
    PureFast.fastSplineCoeffs 34 8 := by decide +kernel

private theorem n34k8_r_bound :
    Kronecker.sumAbs n34k8Data.rCoeffs +
      Kronecker.curvatureCoeffBound 34 8
        n34k8Data.pCoeffs.length (Kronecker.sumAbs n34k8Data.pCoeffs) <
      n34k8RBase.natAbs := by decide +kernel

private theorem n34k8_r_eval :
    Kronecker.intEval n34k8RBase n34k8Data.rCoeffs =
      Kronecker.curvatureEval 34 8 n34k8Data.pCoeffs n34k8RBase := by
  decide +kernel


private theorem n34k8_b_bound :
    Kronecker.sumAbs n34k8Data.transformedCoeffs +
      Kronecker.bernsteinCoeffBound 100 n34k8Data.bernsteinNumerators <
      n34k8BBase.natAbs := by decide +kernel

private theorem n34k8_b_eval :
    Kronecker.intEval n34k8BBase n34k8Data.transformedCoeffs =
      (Kronecker.bernsteinEvalPair n34k8BBase n34k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n34k8_valid : Kronecker.Valid n34k8Data n34k8RBase n34k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n34k8_spline
    r_bound := n34k8_r_bound
    r_eval := n34k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n34k8_b_bound
    b_eval := n34k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n34k8_exists : ∃ c : Pure.CellData,
    c.n = 34 ∧ c.k = 8 ∧
      ∃ rBase bBase : ℤ, Kronecker.Valid c rBase bBase :=
  ⟨n34k8Data, rfl, rfl, n34k8RBase, n34k8BBase, n34k8_valid⟩


