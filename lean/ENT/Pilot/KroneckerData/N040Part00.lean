private noncomputable def n40k8RBase : ℤ := 2 ^ 417
private noncomputable def n40k8BBase : ℤ := 2 ^ 609

private theorem n40k8_spline : n40k8Data.pCoeffs =
    PureFast.fastSplineCoeffs 40 8 := by decide +kernel

private theorem n40k8_r_bound :
    Kronecker.sumAbs n40k8Data.rCoeffs +
      Kronecker.curvatureCoeffBound 40 8
        n40k8Data.pCoeffs.length (Kronecker.sumAbs n40k8Data.pCoeffs) <
      n40k8RBase.natAbs := by decide +kernel

private theorem n40k8_r_eval :
    Kronecker.intEval n40k8RBase n40k8Data.rCoeffs =
      Kronecker.curvatureEval 40 8 n40k8Data.pCoeffs n40k8RBase := by
  decide +kernel


private theorem n40k8_b_bound :
    Kronecker.sumAbs n40k8Data.transformedCoeffs +
      Kronecker.bernsteinCoeffBound 118 n40k8Data.bernsteinNumerators <
      n40k8BBase.natAbs := by decide +kernel

private theorem n40k8_b_eval :
    Kronecker.intEval n40k8BBase n40k8Data.transformedCoeffs =
      (Kronecker.bernsteinEvalPair n40k8BBase n40k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n40k8_valid : Kronecker.Valid n40k8Data n40k8RBase n40k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n40k8_spline
    r_bound := n40k8_r_bound
    r_eval := n40k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n40k8_b_bound
    b_eval := n40k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n40k8_exists : ∃ c : Pure.CellData,
    c.n = 40 ∧ c.k = 8 ∧
      ∃ rBase bBase : ℤ, Kronecker.Valid c rBase bBase :=
  ⟨n40k8Data, rfl, rfl, n40k8RBase, n40k8BBase, n40k8_valid⟩



end ENT.Pilot.KroneckerData
