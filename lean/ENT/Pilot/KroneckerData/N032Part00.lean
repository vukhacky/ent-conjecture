private noncomputable def n32k8RBase : ℤ := 2 ^ 336
private noncomputable def n32k8BBase : ℤ := 2 ^ 483

private theorem n32k8_spline : n32k8Data.pCoeffs =
    PureFast.fastSplineCoeffs 32 8 := by decide +kernel

private theorem n32k8_r_bound :
    Kronecker.sumAbs n32k8Data.rCoeffs +
      Kronecker.curvatureCoeffBound 32 8
        n32k8Data.pCoeffs.length (Kronecker.sumAbs n32k8Data.pCoeffs) <
      n32k8RBase.natAbs := by decide +kernel

private theorem n32k8_r_eval :
    Kronecker.intEval n32k8RBase n32k8Data.rCoeffs =
      Kronecker.curvatureEval 32 8 n32k8Data.pCoeffs n32k8RBase := by
  decide +kernel


private theorem n32k8_b_bound :
    Kronecker.sumAbs n32k8Data.transformedCoeffs +
      Kronecker.bernsteinCoeffBound 94 n32k8Data.bernsteinNumerators <
      n32k8BBase.natAbs := by decide +kernel

private theorem n32k8_b_eval :
    Kronecker.intEval n32k8BBase n32k8Data.transformedCoeffs =
      (Kronecker.bernsteinEvalPair n32k8BBase n32k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n32k8_valid : Kronecker.Valid n32k8Data n32k8RBase n32k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n32k8_spline
    r_bound := n32k8_r_bound
    r_eval := n32k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n32k8_b_bound
    b_eval := n32k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n32k8_exists : ∃ c : Pure.CellData,
    c.n = 32 ∧ c.k = 8 ∧
      ∃ rBase bBase : ℤ, Kronecker.Valid c rBase bBase :=
  ⟨n32k8Data, rfl, rfl, n32k8RBase, n32k8BBase, n32k8_valid⟩


