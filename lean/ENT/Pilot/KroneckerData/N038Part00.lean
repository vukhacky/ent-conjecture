private noncomputable def n38k8RBase : ℤ := 2 ^ 397
private noncomputable def n38k8BBase : ℤ := 2 ^ 578

private theorem n38k8_spline : n38k8Data.pCoeffs =
    PureFast.fastSplineCoeffs 38 8 := by decide +kernel

private theorem n38k8_r_bound :
    Kronecker.sumAbs n38k8Data.rCoeffs +
      Kronecker.curvatureCoeffBound 38 8
        n38k8Data.pCoeffs.length (Kronecker.sumAbs n38k8Data.pCoeffs) <
      n38k8RBase.natAbs := by decide +kernel

private theorem n38k8_r_eval :
    Kronecker.intEval n38k8RBase n38k8Data.rCoeffs =
      Kronecker.curvatureEval 38 8 n38k8Data.pCoeffs n38k8RBase := by
  decide +kernel


private theorem n38k8_b_bound :
    Kronecker.sumAbs n38k8Data.transformedCoeffs +
      Kronecker.bernsteinCoeffBound 112 n38k8Data.bernsteinNumerators <
      n38k8BBase.natAbs := by decide +kernel

private theorem n38k8_b_eval :
    Kronecker.intEval n38k8BBase n38k8Data.transformedCoeffs =
      (Kronecker.bernsteinEvalPair n38k8BBase n38k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n38k8_valid : Kronecker.Valid n38k8Data n38k8RBase n38k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n38k8_spline
    r_bound := n38k8_r_bound
    r_eval := n38k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n38k8_b_bound
    b_eval := n38k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n38k8_exists : ∃ c : Pure.CellData,
    c.n = 38 ∧ c.k = 8 ∧
      ∃ rBase bBase : ℤ, Kronecker.Valid c rBase bBase :=
  ⟨n38k8Data, rfl, rfl, n38k8RBase, n38k8BBase, n38k8_valid⟩



end ENT.Pilot.KroneckerData
