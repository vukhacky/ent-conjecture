private noncomputable def n33k8RBase : ℤ := 2 ^ 346
private noncomputable def n33k8BBase : ℤ := 2 ^ 499

private theorem n33k8_spline : n33k8Data.pCoeffs =
    PureFast.fastSplineCoeffs 33 8 := by decide +kernel

private theorem n33k8_r_bound :
    Kronecker.sumAbs n33k8Data.rCoeffs +
      Kronecker.curvatureCoeffBound 33 8
        n33k8Data.pCoeffs.length (Kronecker.sumAbs n33k8Data.pCoeffs) <
      n33k8RBase.natAbs := by decide +kernel

private theorem n33k8_r_eval :
    Kronecker.intEval n33k8RBase n33k8Data.rCoeffs =
      Kronecker.curvatureEval 33 8 n33k8Data.pCoeffs n33k8RBase := by
  decide +kernel


private theorem n33k8_b_bound :
    Kronecker.sumAbs n33k8Data.transformedCoeffs +
      Kronecker.bernsteinCoeffBound 97 n33k8Data.bernsteinNumerators <
      n33k8BBase.natAbs := by decide +kernel

private theorem n33k8_b_eval :
    Kronecker.intEval n33k8BBase n33k8Data.transformedCoeffs =
      (Kronecker.bernsteinEvalPair n33k8BBase n33k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n33k8_valid : Kronecker.Valid n33k8Data n33k8RBase n33k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n33k8_spline
    r_bound := n33k8_r_bound
    r_eval := n33k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n33k8_b_bound
    b_eval := n33k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n33k8_exists : ∃ c : Pure.CellData,
    c.n = 33 ∧ c.k = 8 ∧
      ∃ rBase bBase : ℤ, Kronecker.Valid c rBase bBase :=
  ⟨n33k8Data, rfl, rfl, n33k8RBase, n33k8BBase, n33k8_valid⟩


