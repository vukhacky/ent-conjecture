    KroneckerLite.fastSplineCoeffs 45 8 := by decide +kernel

private theorem n45k8_r_bound :
    KroneckerLite.sumAbs n45k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 45 8
        n45k8Data.pCoeffs.length (KroneckerLite.sumAbs n45k8Data.pCoeffs) <
      n45k8RBase.natAbs := by decide +kernel

private theorem n45k8_r_eval :
    KroneckerLite.intEval n45k8RBase n45k8Data.rCoeffs =
      KroneckerLite.curvatureEval 45 8 n45k8Data.pCoeffs n45k8RBase := by
  decide +kernel


private theorem n45k8_b_bound :
    KroneckerLite.sumAbs n45k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 133 n45k8Data.bernsteinNumerators <
      n45k8BBase.natAbs := by decide +kernel

private theorem n45k8_b_eval :
    KroneckerLite.intEval n45k8BBase n45k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n45k8BBase n45k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n45k8_valid : KroneckerLite.Valid n45k8Data n45k8RBase n45k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n45k8_spline
    r_bound := n45k8_r_bound
    r_eval := n45k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n45k8_b_bound
    b_eval := n45k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n45k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 45 ∧ c.k = 8 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n45k8Data, rfl, rfl, n45k8RBase, n45k8BBase, n45k8_valid⟩



end ENT.Pilot.KroneckerLiteData
