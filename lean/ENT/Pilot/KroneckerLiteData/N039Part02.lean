      (KroneckerLite.bernsteinEvalPair n39k19BBase n39k19Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n39k19_valid : KroneckerLite.Valid n39k19Data n39k19RBase n39k19BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n39k19_spline
    r_bound := n39k19_r_bound
    r_eval := n39k19_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n39k19_b_bound
    b_eval := n39k19_b_eval
    nonneg := by decide +kernel
  }

public theorem n39k19_exists : ∃ c : KroneckerLite.CellData,
    c.n = 39 ∧ c.k = 19 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n39k19Data, rfl, rfl, n39k19RBase, n39k19BBase, n39k19_valid⟩



end ENT.Pilot.KroneckerLiteData
