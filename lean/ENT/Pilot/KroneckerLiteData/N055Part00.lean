private theorem n55k8_spline : n55k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 55 8 := by decide +kernel

private theorem n55k8_r_bound :
    KroneckerLite.sumAbs n55k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 55 8
        n55k8Data.pCoeffs.length (KroneckerLite.sumAbs n55k8Data.pCoeffs) <
      n55k8RBase.natAbs := by decide +kernel

private theorem n55k8_r_eval :
    KroneckerLite.intEval n55k8RBase n55k8Data.rCoeffs =
      KroneckerLite.curvatureEval 55 8 n55k8Data.pCoeffs n55k8RBase := by
  decide +kernel


private theorem n55k8_b_bound :
    KroneckerLite.sumAbs n55k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 163 n55k8Data.bernsteinNumerators <
      n55k8BBase.natAbs := by decide +kernel

private theorem n55k8_b_eval :
