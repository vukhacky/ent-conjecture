private noncomputable def n50k8RBase : Int := 2 ^ 516
private noncomputable def n50k8BBase : Int := 2 ^ 764

private theorem n50k8_spline : n50k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 50 8 := by decide +kernel

private theorem n50k8_r_bound :
    KroneckerLite.sumAbs n50k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 50 8
        n50k8Data.pCoeffs.length (KroneckerLite.sumAbs n50k8Data.pCoeffs) <
      n50k8RBase.natAbs := by decide +kernel

private theorem n50k8_r_eval :
    KroneckerLite.intEval n50k8RBase n50k8Data.rCoeffs =
      KroneckerLite.curvatureEval 50 8 n50k8Data.pCoeffs n50k8RBase := by
  decide +kernel


private theorem n50k8_b_bound :
    KroneckerLite.sumAbs n50k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 148 n50k8Data.bernsteinNumerators <
      n50k8BBase.natAbs := by decide +kernel

private theorem n50k8_b_eval :
    KroneckerLite.intEval n50k8BBase n50k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n50k8BBase n50k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n50k8_valid : KroneckerLite.Valid n50k8Data n50k8RBase n50k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n50k8_spline
    r_bound := n50k8_r_bound
    r_eval := n50k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n50k8_b_bound
    b_eval := n50k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n50k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 50 ∧ c.k = 8 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n50k8Data, rfl, rfl, n50k8RBase, n50k8BBase, n50k8_valid⟩



end ENT.Pilot.KroneckerLiteData
