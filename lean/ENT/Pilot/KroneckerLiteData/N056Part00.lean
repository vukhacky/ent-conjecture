private noncomputable def n56k8BBase : Int := 2 ^ 856

private theorem n56k8_spline : n56k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 56 8 := by decide +kernel

private theorem n56k8_r_bound :
    KroneckerLite.sumAbs n56k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 56 8
