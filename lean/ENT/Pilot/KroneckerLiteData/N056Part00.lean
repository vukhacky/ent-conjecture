      n56k8RBase.natAbs := by decide +kernel

private theorem n56k8_r_eval :
    KroneckerLite.intEval n56k8RBase n56k8Data.rCoeffs =
      KroneckerLite.curvatureEval 56 8 n56k8Data.pCoeffs n56k8RBase := by
  decide +kernel


private theorem n56k8_b_bound :
    KroneckerLite.sumAbs n56k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 166 n56k8Data.bernsteinNumerators <
      n56k8BBase.natAbs := by decide +kernel

