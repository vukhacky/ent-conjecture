        n77k32Data.pCoeffs.length (KroneckerLite.sumAbs n77k32Data.pCoeffs) <
      n77k32RBase.natAbs := by decide +kernel

private theorem n77k32_r_eval :
    KroneckerLite.intEval n77k32RBase n77k32Data.rCoeffs =
      KroneckerLite.curvatureEval 77 32 n77k32Data.pCoeffs n77k32RBase := by
  decide +kernel


private theorem n77k32_b_bound :
    KroneckerLite.sumAbs n77k32Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 229 n77k32Data.bernsteinNumerators <
      n77k32BBase.natAbs := by decide +kernel

private theorem n77k32_b_eval :
    KroneckerLite.intEval n77k32BBase n77k32Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n77k32BBase n77k32Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n77k32_valid : KroneckerLite.Valid n77k32Data n77k32RBase n77k32BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n77k32_spline
    r_bound := n77k32_r_bound
    r_eval := n77k32_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n77k32_b_bound
    b_eval := n77k32_b_eval
    nonneg := by decide +kernel
  }

public theorem n77k32_exists : ∃ c : KroneckerLite.CellData,
    c.n = 77 ∧ c.k = 32 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n77k32Data, rfl, rfl, n77k32RBase, n77k32BBase, n77k32_valid⟩



end ENT.Pilot.KroneckerLiteData
