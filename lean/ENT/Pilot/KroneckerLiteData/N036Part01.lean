private theorem n36k16_b_eval :
    KroneckerLite.intEval n36k16BBase n36k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n36k16BBase n36k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n36k16_valid : KroneckerLite.Valid n36k16Data n36k16RBase n36k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n36k16_spline
    r_bound := n36k16_r_bound
    r_eval := n36k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n36k16_b_bound
    b_eval := n36k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n36k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 36 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n36k16Data, rfl, rfl, n36k16RBase, n36k16BBase, n36k16_valid⟩



end ENT.Pilot.KroneckerLiteData
