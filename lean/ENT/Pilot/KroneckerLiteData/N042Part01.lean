public theorem n42k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 42 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n42k16Data, rfl, rfl, n42k16RBase, n42k16BBase, n42k16_valid⟩



end ENT.Pilot.KroneckerLiteData
