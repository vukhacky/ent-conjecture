private noncomputable def n64k24RBase : Int := 2 ^ 896
private noncomputable def n64k24BBase : Int := 2 ^ 1229

private theorem n64k24_spline : n64k24Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 64 24 := by decide +kernel

private theorem n64k24_r_bound :
    KroneckerLite.sumAbs n64k24Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 64 24
        n64k24Data.pCoeffs.length (KroneckerLite.sumAbs n64k24Data.pCoeffs) <
      n64k24RBase.natAbs := by decide +kernel

private theorem n64k24_r_eval :
    KroneckerLite.intEval n64k24RBase n64k24Data.rCoeffs =
      KroneckerLite.curvatureEval 64 24 n64k24Data.pCoeffs n64k24RBase := by
  decide +kernel


private theorem n64k24_b_bound :
    KroneckerLite.sumAbs n64k24Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 190 n64k24Data.bernsteinNumerators <
      n64k24BBase.natAbs := by decide +kernel

private theorem n64k24_b_eval :
    KroneckerLite.intEval n64k24BBase n64k24Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n64k24BBase n64k24Data.bernsteinNumerators).2 := by
  decide +kernel


