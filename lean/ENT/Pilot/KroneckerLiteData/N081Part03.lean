    KroneckerLite.fastSplineCoeffs 81 32 := by decide +kernel

private theorem n81k32_r_bound :
    KroneckerLite.sumAbs n81k32Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 81 32
        n81k32Data.pCoeffs.length (KroneckerLite.sumAbs n81k32Data.pCoeffs) <
      n81k32RBase.natAbs := by decide +kernel

private theorem n81k32_r_eval :
    KroneckerLite.intEval n81k32RBase n81k32Data.rCoeffs =
      KroneckerLite.curvatureEval 81 32 n81k32Data.pCoeffs n81k32RBase := by
  decide +kernel


private theorem n81k32_b_bound :
    KroneckerLite.sumAbs n81k32Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 241 n81k32Data.bernsteinNumerators <
      n81k32BBase.natAbs := by decide +kernel

private theorem n81k32_b_eval :
    KroneckerLite.intEval n81k32BBase n81k32Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n81k32BBase n81k32Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n81k32_valid : KroneckerLite.Valid n81k32Data n81k32RBase n81k32BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n81k32_spline
    r_bound := n81k32_r_bound
    r_eval := n81k32_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n81k32_b_bound
    b_eval := n81k32_b_eval
    nonneg := by decide +kernel
  }

public theorem n81k32_exists : ∃ c : KroneckerLite.CellData,
    c.n = 81 ∧ c.k = 32 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n81k32Data, rfl, rfl, n81k32RBase, n81k32BBase, n81k32_valid⟩



end ENT.Pilot.KroneckerLiteData
