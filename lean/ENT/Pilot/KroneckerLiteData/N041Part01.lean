    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n41k16_b_bound
    b_eval := n41k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n41k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 41 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n41k16Data, rfl, rfl, n41k16RBase, n41k16BBase, n41k16_valid⟩



