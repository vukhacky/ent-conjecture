    KroneckerLite.sumAbs n41k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 121 n41k16Data.bernsteinNumerators <
      n41k16BBase.natAbs := by decide +kernel

private theorem n41k16_b_eval :
    KroneckerLite.intEval n41k16BBase n41k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n41k16BBase n41k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n41k16_valid : KroneckerLite.Valid n41k16Data n41k16RBase n41k16BBase := by
  refine {
