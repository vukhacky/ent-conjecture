private theorem n80k24_r_eval :
    KroneckerLite.intEval n80k24RBase n80k24Data.rCoeffs =
      KroneckerLite.curvatureEval 80 24 n80k24Data.pCoeffs n80k24RBase := by
  decide +kernel


private theorem n80k24_b_bound :
    KroneckerLite.sumAbs n80k24Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 238 n80k24Data.bernsteinNumerators <
      n80k24BBase.natAbs := by decide +kernel

private theorem n80k24_b_eval :
    KroneckerLite.intEval n80k24BBase n80k24Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n80k24BBase n80k24Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n80k24_valid : KroneckerLite.Valid n80k24Data n80k24RBase n80k24BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n80k24_spline
    r_bound := n80k24_r_bound
    r_eval := n80k24_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n80k24_b_bound
    b_eval := n80k24_b_eval
    nonneg := by decide +kernel
  }

public theorem n80k24_exists : ∃ c : KroneckerLite.CellData,
    c.n = 80 ∧ c.k = 24 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n80k24Data, rfl, rfl, n80k24RBase, n80k24BBase, n80k24_valid⟩



end ENT.Pilot.KroneckerLiteData
