private noncomputable def n68k16RBase : Int := 2 ^ 870
private noncomputable def n68k16BBase : Int := 2 ^ 1225

private theorem n68k16_spline : n68k16Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 68 16 := by decide +kernel

private theorem n68k16_r_bound :
    KroneckerLite.sumAbs n68k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 68 16
        n68k16Data.pCoeffs.length (KroneckerLite.sumAbs n68k16Data.pCoeffs) <
      n68k16RBase.natAbs := by decide +kernel

private theorem n68k16_r_eval :
    KroneckerLite.intEval n68k16RBase n68k16Data.rCoeffs =
      KroneckerLite.curvatureEval 68 16 n68k16Data.pCoeffs n68k16RBase := by
  decide +kernel


private theorem n68k16_b_bound :
    KroneckerLite.sumAbs n68k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 202 n68k16Data.bernsteinNumerators <
      n68k16BBase.natAbs := by decide +kernel

private theorem n68k16_b_eval :
    KroneckerLite.intEval n68k16BBase n68k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n68k16BBase n68k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n68k16_valid : KroneckerLite.Valid n68k16Data n68k16RBase n68k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n68k16_spline
    r_bound := n68k16_r_bound
    r_eval := n68k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n68k16_b_bound
    b_eval := n68k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n68k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 68 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n68k16Data, rfl, rfl, n68k16RBase, n68k16BBase, n68k16_valid⟩



