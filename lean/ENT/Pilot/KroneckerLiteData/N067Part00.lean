private noncomputable def n67k8RBase : Int := 2 ^ 682
private noncomputable def n67k8BBase : Int := 2 ^ 1026

private theorem n67k8_spline : n67k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 67 8 := by decide +kernel

private theorem n67k8_r_bound :
    KroneckerLite.sumAbs n67k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 67 8
        n67k8Data.pCoeffs.length (KroneckerLite.sumAbs n67k8Data.pCoeffs) <
      n67k8RBase.natAbs := by decide +kernel

private theorem n67k8_r_eval :
    KroneckerLite.intEval n67k8RBase n67k8Data.rCoeffs =
      KroneckerLite.curvatureEval 67 8 n67k8Data.pCoeffs n67k8RBase := by
  decide +kernel


private theorem n67k8_b_bound :
    KroneckerLite.sumAbs n67k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 199 n67k8Data.bernsteinNumerators <
      n67k8BBase.natAbs := by decide +kernel

private theorem n67k8_b_eval :
    KroneckerLite.intEval n67k8BBase n67k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n67k8BBase n67k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n67k8_valid : KroneckerLite.Valid n67k8Data n67k8RBase n67k8BBase := by
