private noncomputable def n48k16RBase : Int := 2 ^ 609
private noncomputable def n48k16BBase : Int := 2 ^ 848

private theorem n48k16_spline : n48k16Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 48 16 := by decide +kernel

private theorem n48k16_r_bound :
    KroneckerLite.sumAbs n48k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 48 16
        n48k16Data.pCoeffs.length (KroneckerLite.sumAbs n48k16Data.pCoeffs) <
      n48k16RBase.natAbs := by decide +kernel

private theorem n48k16_r_eval :
    KroneckerLite.intEval n48k16RBase n48k16Data.rCoeffs =
      KroneckerLite.curvatureEval 48 16 n48k16Data.pCoeffs n48k16RBase := by
  decide +kernel


private theorem n48k16_b_bound :
    KroneckerLite.sumAbs n48k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 142 n48k16Data.bernsteinNumerators <
      n48k16BBase.natAbs := by decide +kernel

private theorem n48k16_b_eval :
    KroneckerLite.intEval n48k16BBase n48k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n48k16BBase n48k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n48k16_valid : KroneckerLite.Valid n48k16Data n48k16RBase n48k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n48k16_spline
    r_bound := n48k16_r_bound
    r_eval := n48k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n48k16_b_bound
    b_eval := n48k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n48k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 48 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n48k16Data, rfl, rfl, n48k16RBase, n48k16BBase, n48k16_valid⟩



end ENT.Pilot.KroneckerLiteData
