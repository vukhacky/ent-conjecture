    KroneckerLite.fastSplineCoeffs 62 16 := by decide +kernel

private theorem n62k16_r_bound :
    KroneckerLite.sumAbs n62k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 62 16
        n62k16Data.pCoeffs.length (KroneckerLite.sumAbs n62k16Data.pCoeffs) <
      n62k16RBase.natAbs := by decide +kernel

private theorem n62k16_r_eval :
    KroneckerLite.intEval n62k16RBase n62k16Data.rCoeffs =
      KroneckerLite.curvatureEval 62 16 n62k16Data.pCoeffs n62k16RBase := by
  decide +kernel


private theorem n62k16_b_bound :
    KroneckerLite.sumAbs n62k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 184 n62k16Data.bernsteinNumerators <
      n62k16BBase.natAbs := by decide +kernel

private theorem n62k16_b_eval :
    KroneckerLite.intEval n62k16BBase n62k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n62k16BBase n62k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n62k16_valid : KroneckerLite.Valid n62k16Data n62k16RBase n62k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n62k16_spline
    r_bound := n62k16_r_bound
    r_eval := n62k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n62k16_b_bound
    b_eval := n62k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n62k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 62 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n62k16Data, rfl, rfl, n62k16RBase, n62k16BBase, n62k16_valid⟩



end ENT.Pilot.KroneckerLiteData
