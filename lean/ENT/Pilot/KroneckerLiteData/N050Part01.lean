private noncomputable def n50k16RBase : Int := 2 ^ 636
private noncomputable def n50k16BBase : Int := 2 ^ 887

private theorem n50k16_spline : n50k16Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 50 16 := by decide +kernel

private theorem n50k16_r_bound :
    KroneckerLite.sumAbs n50k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 50 16
        n50k16Data.pCoeffs.length (KroneckerLite.sumAbs n50k16Data.pCoeffs) <
      n50k16RBase.natAbs := by decide +kernel

private theorem n50k16_r_eval :
    KroneckerLite.intEval n50k16RBase n50k16Data.rCoeffs =
      KroneckerLite.curvatureEval 50 16 n50k16Data.pCoeffs n50k16RBase := by
  decide +kernel


private theorem n50k16_b_bound :
    KroneckerLite.sumAbs n50k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 148 n50k16Data.bernsteinNumerators <
      n50k16BBase.natAbs := by decide +kernel

private theorem n50k16_b_eval :
    KroneckerLite.intEval n50k16BBase n50k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n50k16BBase n50k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n50k16_valid : KroneckerLite.Valid n50k16Data n50k16RBase n50k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n50k16_spline
    r_bound := n50k16_r_bound
    r_eval := n50k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n50k16_b_bound
    b_eval := n50k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n50k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 50 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n50k16Data, rfl, rfl, n50k16RBase, n50k16BBase, n50k16_valid⟩



