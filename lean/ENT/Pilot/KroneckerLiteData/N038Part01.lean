private noncomputable def n38k16RBase : Int := 2 ^ 469
private noncomputable def n38k16BBase : Int := 2 ^ 651

private theorem n38k16_spline : n38k16Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 38 16 := by decide +kernel

private theorem n38k16_r_bound :
    KroneckerLite.sumAbs n38k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 38 16
        n38k16Data.pCoeffs.length (KroneckerLite.sumAbs n38k16Data.pCoeffs) <
      n38k16RBase.natAbs := by decide +kernel

private theorem n38k16_r_eval :
    KroneckerLite.intEval n38k16RBase n38k16Data.rCoeffs =
      KroneckerLite.curvatureEval 38 16 n38k16Data.pCoeffs n38k16RBase := by
  decide +kernel


private theorem n38k16_b_bound :
    KroneckerLite.sumAbs n38k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 112 n38k16Data.bernsteinNumerators <
      n38k16BBase.natAbs := by decide +kernel

private theorem n38k16_b_eval :
    KroneckerLite.intEval n38k16BBase n38k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n38k16BBase n38k16Data.bernsteinNumerators).2 := by
  decide +kernel


