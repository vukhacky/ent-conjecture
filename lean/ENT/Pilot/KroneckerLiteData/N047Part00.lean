private noncomputable def n47k8RBase : Int := 2 ^ 487
private noncomputable def n47k8BBase : Int := 2 ^ 717

private theorem n47k8_spline : n47k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 47 8 := by decide +kernel

private theorem n47k8_r_bound :
    KroneckerLite.sumAbs n47k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 47 8
        n47k8Data.pCoeffs.length (KroneckerLite.sumAbs n47k8Data.pCoeffs) <
      n47k8RBase.natAbs := by decide +kernel

private theorem n47k8_r_eval :
    KroneckerLite.intEval n47k8RBase n47k8Data.rCoeffs =
      KroneckerLite.curvatureEval 47 8 n47k8Data.pCoeffs n47k8RBase := by
  decide +kernel


private theorem n47k8_b_bound :
    KroneckerLite.sumAbs n47k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 139 n47k8Data.bernsteinNumerators <
      n47k8BBase.natAbs := by decide +kernel

private theorem n47k8_b_eval :
    KroneckerLite.intEval n47k8BBase n47k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n47k8BBase n47k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n47k8_valid : KroneckerLite.Valid n47k8Data n47k8RBase n47k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
