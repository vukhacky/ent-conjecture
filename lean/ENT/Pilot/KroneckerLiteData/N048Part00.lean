private noncomputable def n48k8RBase : Int := 2 ^ 496
private noncomputable def n48k8BBase : Int := 2 ^ 733

private theorem n48k8_spline : n48k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 48 8 := by decide +kernel

private theorem n48k8_r_bound :
    KroneckerLite.sumAbs n48k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 48 8
        n48k8Data.pCoeffs.length (KroneckerLite.sumAbs n48k8Data.pCoeffs) <
      n48k8RBase.natAbs := by decide +kernel

private theorem n48k8_r_eval :
    KroneckerLite.intEval n48k8RBase n48k8Data.rCoeffs =
      KroneckerLite.curvatureEval 48 8 n48k8Data.pCoeffs n48k8RBase := by
  decide +kernel


private theorem n48k8_b_bound :
    KroneckerLite.sumAbs n48k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 142 n48k8Data.bernsteinNumerators <
      n48k8BBase.natAbs := by decide +kernel

private theorem n48k8_b_eval :
    KroneckerLite.intEval n48k8BBase n48k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n48k8BBase n48k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n48k8_valid : KroneckerLite.Valid n48k8Data n48k8RBase n48k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n48k8_spline
    r_bound := n48k8_r_bound
    r_eval := n48k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n48k8_b_bound
    b_eval := n48k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n48k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 48 ∧ c.k = 8 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n48k8Data, rfl, rfl, n48k8RBase, n48k8BBase, n48k8_valid⟩



end ENT.Pilot.KroneckerLiteData
