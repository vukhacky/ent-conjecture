private noncomputable def n42k8RBase : Int := 2 ^ 437
private noncomputable def n42k8BBase : Int := 2 ^ 640

private theorem n42k8_spline : n42k8Data.pCoeffs =
    KroneckerLite.fastSplineCoeffs 42 8 := by decide +kernel

private theorem n42k8_r_bound :
    KroneckerLite.sumAbs n42k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 42 8
        n42k8Data.pCoeffs.length (KroneckerLite.sumAbs n42k8Data.pCoeffs) <
      n42k8RBase.natAbs := by decide +kernel

private theorem n42k8_r_eval :
    KroneckerLite.intEval n42k8RBase n42k8Data.rCoeffs =
      KroneckerLite.curvatureEval 42 8 n42k8Data.pCoeffs n42k8RBase := by
  decide +kernel


private theorem n42k8_b_bound :
    KroneckerLite.sumAbs n42k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 124 n42k8Data.bernsteinNumerators <
      n42k8BBase.natAbs := by decide +kernel

private theorem n42k8_b_eval :
    KroneckerLite.intEval n42k8BBase n42k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n42k8BBase n42k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n42k8_valid : KroneckerLite.Valid n42k8Data n42k8RBase n42k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n42k8_spline
    r_bound := n42k8_r_bound
    r_eval := n42k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n42k8_b_bound
    b_eval := n42k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n42k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 42 ∧ c.k = 8 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n42k8Data, rfl, rfl, n42k8RBase, n42k8BBase, n42k8_valid⟩



