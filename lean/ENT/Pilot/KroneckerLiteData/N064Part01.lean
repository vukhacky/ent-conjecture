      (KroneckerLite.bernsteinEvalPair n64k16BBase n64k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n64k16_valid : KroneckerLite.Valid n64k16Data n64k16RBase n64k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    spline := n64k16_spline
    r_bound := n64k16_r_bound
    r_eval := n64k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n64k16_b_bound
    b_eval := n64k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n64k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 64 ∧ c.k = 16 ∧
      ∃ rBase bBase : Int, KroneckerLite.Valid c rBase bBase :=
  ⟨n64k16Data, rfl, rfl, n64k16RBase, n64k16BBase, n64k16_valid⟩



end ENT.Pilot.KroneckerLiteData
