    KroneckerLite.intEval n130k64PBase n130k64Data.pCoeffs =
      KroneckerSpline.canonicalEval 130 64 n130k64PBase := by decide +kernel

private theorem n130k64_b_bound :
    (n130k64Data.degreeBound + 1) * KroneckerDirect.qCoeffBound n130k64Data +
      KroneckerLite.bernsteinCoeffBound 388 n130k64Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n130k64Data n130k64U).natAbs := by decide +kernel

private theorem n130k64_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n130k64Data n130k64U)
      n130k64Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n130k64Data *
        KroneckerLite.curvatureEval 130 64 n130k64Data.pCoeffs n130k64U := by
  decide +kernel

private theorem n130k64_valid : KroneckerDirect.Valid n130k64Data n130k64PBase n130k64U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n130k64_p_bound
    p_eval := n130k64_p_eval
    b_length := by decide +kernel
    b_bound := n130k64_b_bound
    direct_eval := n130k64_direct_eval
    nonneg := by decide +kernel
  }

public theorem n130k64_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 130 ∧ c.k = 64 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n130k64Data, rfl, rfl, n130k64PBase, n130k64U, n130k64_valid⟩


end ENT.Pilot.KroneckerDirectData
