      KroneckerLite.bernsteinCoeffBound 427 n143k16Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n143k16Data n143k16U).natAbs := by decide +kernel

private theorem n143k16_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n143k16Data n143k16U)
      n143k16Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n143k16Data *
        KroneckerLite.curvatureEval 143 16 n143k16Data.pCoeffs n143k16U := by
  decide +kernel

private theorem n143k16_valid : KroneckerDirect.Valid n143k16Data n143k16PBase n143k16U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n143k16_p_bound
    p_eval := n143k16_p_eval
    b_length := by decide +kernel
    b_bound := n143k16_b_bound
    direct_eval := n143k16_direct_eval
    nonneg := by decide +kernel
  }

public theorem n143k16_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 143 ∧ c.k = 16 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n143k16Data, rfl, rfl, n143k16PBase, n143k16U, n143k16_valid⟩


end ENT.Pilot.KroneckerDirectData
