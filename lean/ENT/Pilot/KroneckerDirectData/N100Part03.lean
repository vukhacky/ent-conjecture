    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n100k32Data n100k32U)
      n100k32Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n100k32Data *
        KroneckerLite.curvatureEval 100 32 n100k32Data.pCoeffs n100k32U := by
  decide +kernel

private theorem n100k32_valid : KroneckerDirect.Valid n100k32Data n100k32PBase n100k32U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n100k32_p_bound
    p_eval := n100k32_p_eval
    b_length := by decide +kernel
    b_bound := n100k32_b_bound
    direct_eval := n100k32_direct_eval
    nonneg := by decide +kernel
  }

public theorem n100k32_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 100 ∧ c.k = 32 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n100k32Data, rfl, rfl, n100k32PBase, n100k32U, n100k32_valid⟩


end ENT.Pilot.KroneckerDirectData
