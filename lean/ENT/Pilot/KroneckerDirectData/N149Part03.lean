      KroneckerSpline.canonicalEval 149 32 n149k32PBase := by decide +kernel

private theorem n149k32_b_bound :
    (n149k32Data.degreeBound + 1) * KroneckerDirect.qCoeffBound n149k32Data +
      KroneckerLite.bernsteinCoeffBound 445 n149k32Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n149k32Data n149k32U).natAbs := by decide +kernel

private theorem n149k32_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n149k32Data n149k32U)
      n149k32Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n149k32Data *
        KroneckerLite.curvatureEval 149 32 n149k32Data.pCoeffs n149k32U := by
  decide +kernel

private theorem n149k32_valid : KroneckerDirect.Valid n149k32Data n149k32PBase n149k32U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n149k32_p_bound
    p_eval := n149k32_p_eval
    b_length := by decide +kernel
    b_bound := n149k32_b_bound
    direct_eval := n149k32_direct_eval
    nonneg := by decide +kernel
  }

public theorem n149k32_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 149 ∧ c.k = 32 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n149k32Data, rfl, rfl, n149k32PBase, n149k32U, n149k32_valid⟩


end ENT.Pilot.KroneckerDirectData
