private noncomputable def n100k40PBase : Int := 2 ^ 735
private noncomputable def n100k40U : Int := 2 ^ 2128

private theorem n100k40_p_bound :
    KroneckerLite.sumAbs n100k40Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 100 40 <
      n100k40PBase.natAbs := by decide +kernel

private theorem n100k40_p_eval :
    KroneckerLite.intEval n100k40PBase n100k40Data.pCoeffs =
      KroneckerSpline.canonicalEval 100 40 n100k40PBase := by decide +kernel

private theorem n100k40_b_bound :
    (n100k40Data.degreeBound + 1) * KroneckerDirect.qCoeffBound n100k40Data +
      KroneckerLite.bernsteinCoeffBound 298 n100k40Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n100k40Data n100k40U).natAbs := by decide +kernel

private theorem n100k40_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n100k40Data n100k40U)
