      KroneckerLite.bernsteinCoeffBound 394 n132k32Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n132k32Data n132k32U).natAbs := by decide +kernel

private theorem n132k32_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n132k32Data n132k32U)
      n132k32Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n132k32Data *
        KroneckerLite.curvatureEval 132 32 n132k32Data.pCoeffs n132k32U := by
  decide +kernel

private theorem n132k32_valid : KroneckerDirect.Valid n132k32Data n132k32PBase n132k32U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n132k32_p_bound
    p_eval := n132k32_p_eval
    b_length := by decide +kernel
    b_bound := n132k32_b_bound
    direct_eval := n132k32_direct_eval
    nonneg := by decide +kernel
  }

public theorem n132k32_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 132 ∧ c.k = 32 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n132k32Data, rfl, rfl, n132k32PBase, n132k32U, n132k32_valid⟩


end ENT.Pilot.KroneckerDirectData
