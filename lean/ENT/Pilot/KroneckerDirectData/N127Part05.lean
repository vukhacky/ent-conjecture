      KroneckerLite.bernsteinCoeffBound 379 n127k48Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n127k48Data n127k48U).natAbs := by decide +kernel

private theorem n127k48_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n127k48Data n127k48U)
      n127k48Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n127k48Data *
        KroneckerLite.curvatureEval 127 48 n127k48Data.pCoeffs n127k48U := by
  decide +kernel

private theorem n127k48_valid : KroneckerDirect.Valid n127k48Data n127k48PBase n127k48U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n127k48_p_bound
    p_eval := n127k48_p_eval
    b_length := by decide +kernel
    b_bound := n127k48_b_bound
    direct_eval := n127k48_direct_eval
    nonneg := by decide +kernel
  }

public theorem n127k48_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 127 ∧ c.k = 48 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n127k48Data, rfl, rfl, n127k48PBase, n127k48U, n127k48_valid⟩


end ENT.Pilot.KroneckerDirectData
