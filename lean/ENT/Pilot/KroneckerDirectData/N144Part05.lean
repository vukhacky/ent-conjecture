      KroneckerLite.bernsteinCoeffBound 430 n144k48Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n144k48Data n144k48U).natAbs := by decide +kernel

private theorem n144k48_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n144k48Data n144k48U)
      n144k48Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n144k48Data *
        KroneckerLite.curvatureEval 144 48 n144k48Data.pCoeffs n144k48U := by
  decide +kernel

private theorem n144k48_valid : KroneckerDirect.Valid n144k48Data n144k48PBase n144k48U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n144k48_p_bound
    p_eval := n144k48_p_eval
    b_length := by decide +kernel
    b_bound := n144k48_b_bound
    direct_eval := n144k48_direct_eval
    nonneg := by decide +kernel
  }

public theorem n144k48_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 144 ∧ c.k = 48 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n144k48Data, rfl, rfl, n144k48PBase, n144k48U, n144k48_valid⟩


end ENT.Pilot.KroneckerDirectData
