  }

public theorem n147k64_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 147 ∧ c.k = 64 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n147k64Data, rfl, rfl, n147k64PBase, n147k64U, n147k64_valid⟩


