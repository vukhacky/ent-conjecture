  }

public theorem n145k40_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 145 ∧ c.k = 40 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n145k40Data, rfl, rfl, n145k40PBase, n145k40U, n145k40_valid⟩


