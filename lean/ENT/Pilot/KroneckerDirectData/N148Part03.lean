    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n148k32Data n148k32U)
      n148k32Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n148k32Data *
        KroneckerLite.curvatureEval 148 32 n148k32Data.pCoeffs n148k32U := by
  decide +kernel

private theorem n148k32_valid : KroneckerDirect.Valid n148k32Data n148k32PBase n148k32U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n148k32_p_bound
    p_eval := n148k32_p_eval
    b_length := by decide +kernel
    b_bound := n148k32_b_bound
    direct_eval := n148k32_direct_eval
    nonneg := by decide +kernel
  }

public theorem n148k32_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 148 ∧ c.k = 32 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n148k32Data, rfl, rfl, n148k32PBase, n148k32U, n148k32_valid⟩


end ENT.Pilot.KroneckerDirectData
