      (KroneckerDirect.evaluationBase n104k24Data n104k24U).natAbs := by decide +kernel

private theorem n104k24_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n104k24Data n104k24U)
      n104k24Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n104k24Data *
        KroneckerLite.curvatureEval 104 24 n104k24Data.pCoeffs n104k24U := by
  decide +kernel

