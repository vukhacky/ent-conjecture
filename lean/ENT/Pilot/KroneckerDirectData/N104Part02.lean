  }

public theorem n104k24_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 104 ∧ c.k = 24 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n104k24Data, rfl, rfl, n104k24PBase, n104k24U, n104k24_valid⟩


