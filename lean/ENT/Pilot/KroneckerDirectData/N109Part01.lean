    KroneckerLite.sumAbs n109k16Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 109 16 <
      n109k16PBase.natAbs := by decide +kernel

private theorem n109k16_p_eval :
    KroneckerLite.intEval n109k16PBase n109k16Data.pCoeffs =
      KroneckerSpline.canonicalEval 109 16 n109k16PBase := by decide +kernel

private theorem n109k16_b_bound :
    (n109k16Data.degreeBound + 1) * KroneckerDirect.qCoeffBound n109k16Data +
      KroneckerLite.bernsteinCoeffBound 325 n109k16Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n109k16Data n109k16U).natAbs := by decide +kernel

private theorem n109k16_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n109k16Data n109k16U)
      n109k16Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n109k16Data *
        KroneckerLite.curvatureEval 109 16 n109k16Data.pCoeffs n109k16U := by
  decide +kernel

private theorem n109k16_valid : KroneckerDirect.Valid n109k16Data n109k16PBase n109k16U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n109k16_p_bound
    p_eval := n109k16_p_eval
    b_length := by decide +kernel
    b_bound := n109k16_b_bound
    direct_eval := n109k16_direct_eval
    nonneg := by decide +kernel
  }

public theorem n109k16_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 109 ∧ c.k = 16 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n109k16Data, rfl, rfl, n109k16PBase, n109k16U, n109k16_valid⟩


end ENT.Pilot.KroneckerDirectData
