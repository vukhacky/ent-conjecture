private noncomputable def n100k48PBase : Int := 2 ^ 761
private noncomputable def n100k48U : Int := 2 ^ 2148

private theorem n100k48_p_bound :
    KroneckerLite.sumAbs n100k48Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 100 48 <
      n100k48PBase.natAbs := by decide +kernel

private theorem n100k48_p_eval :
    KroneckerLite.intEval n100k48PBase n100k48Data.pCoeffs =
      KroneckerSpline.canonicalEval 100 48 n100k48PBase := by decide +kernel

private theorem n100k48_b_bound :
    (n100k48Data.degreeBound + 1) * KroneckerDirect.qCoeffBound n100k48Data +
      KroneckerLite.bernsteinCoeffBound 298 n100k48Data.bernsteinNumerators <
      (KroneckerDirect.evaluationBase n100k48Data n100k48U).natAbs := by decide +kernel

private theorem n100k48_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n100k48Data n100k48U)
      n100k48Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n100k48Data *
        KroneckerLite.curvatureEval 100 48 n100k48Data.pCoeffs n100k48U := by
  decide +kernel

private theorem n100k48_valid : KroneckerDirect.Valid n100k48Data n100k48PBase n100k48U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n100k48_p_bound
    p_eval := n100k48_p_eval
    b_length := by decide +kernel
    b_bound := n100k48_b_bound
    direct_eval := n100k48_direct_eval
    nonneg := by decide +kernel
  }

public theorem n100k48_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 100 ∧ c.k = 48 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n100k48Data, rfl, rfl, n100k48PBase, n100k48U, n100k48_valid⟩


