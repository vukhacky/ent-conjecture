    b_bound := n128k48_b_bound
    direct_eval := n128k48_direct_eval
    nonneg := by decide +kernel
  }

public theorem n128k48_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 128 ∧ c.k = 48 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n128k48Data, rfl, rfl, n128k48PBase, n128k48U, n128k48_valid⟩


end ENT.Pilot.KroneckerDirectData
