      (KroneckerDirect.evaluationBase n148k64Data n148k64U).natAbs := by decide +kernel

private theorem n148k64_direct_eval :
    (KroneckerLite.bernsteinEvalPair (KroneckerDirect.evaluationBase n148k64Data n148k64U)
      n148k64Data.bernsteinNumerators).2 =
      KroneckerDirect.transformScale n148k64Data *
        KroneckerLite.curvatureEval 148 64 n148k64Data.pCoeffs n148k64U := by
  decide +kernel

private theorem n148k64_valid : KroneckerDirect.Valid n148k64Data n148k64PBase n148k64U := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    p_length := by decide +kernel
    p_bound := n148k64_p_bound
    p_eval := n148k64_p_eval
    b_length := by decide +kernel
    b_bound := n148k64_b_bound
    direct_eval := n148k64_direct_eval
    nonneg := by decide +kernel
  }

public theorem n148k64_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 148 ∧ c.k = 64 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n148k64Data, rfl, rfl, n148k64PBase, n148k64U, n148k64_valid⟩


end ENT.Pilot.KroneckerDirectData
