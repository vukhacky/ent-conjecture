public theorem n146k32_exists : ∃ c : KroneckerDirect.CellData,
    c.n = 146 ∧ c.k = 32 ∧ ∃ pBase u : Int, KroneckerDirect.Valid c pBase u :=
  ⟨n146k32Data, rfl, rfl, n146k32PBase, n146k32U, n146k32_valid⟩


