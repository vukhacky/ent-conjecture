private noncomputable def n100k8PBase : Int := 2 ^ 516
private noncomputable def n100k8RBase : Int := 2 ^ 1000
private noncomputable def n100k8BBase : Int := 2 ^ 1532

private theorem n100k8_p_bound :
    KroneckerLite.sumAbs n100k8Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 100 8 <
      n100k8PBase.natAbs := by decide +kernel

private theorem n100k8_p_eval :
    KroneckerLite.intEval n100k8PBase n100k8Data.pCoeffs =
      KroneckerSpline.canonicalEval 100 8 n100k8PBase := by
  decide +kernel

private theorem n100k8_r_bound :
    KroneckerLite.sumAbs n100k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 100 8
        n100k8Data.pCoeffs.length (KroneckerLite.sumAbs n100k8Data.pCoeffs) <
      n100k8RBase.natAbs := by decide +kernel

private theorem n100k8_r_eval :
    KroneckerLite.intEval n100k8RBase n100k8Data.rCoeffs =
      KroneckerLite.curvatureEval 100 8 n100k8Data.pCoeffs n100k8RBase := by
  decide +kernel


private theorem n100k8_b_bound :
    KroneckerLite.sumAbs n100k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 298 n100k8Data.bernsteinNumerators <
      n100k8BBase.natAbs := by decide +kernel

private theorem n100k8_b_eval :
    KroneckerLite.intEval n100k8BBase n100k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n100k8BBase n100k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n100k8_valid : KroneckerSpline.Valid n100k8Data n100k8PBase n100k8RBase n100k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n100k8_p_bound
    p_eval := n100k8_p_eval
    r_bound := n100k8_r_bound
    r_eval := n100k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n100k8_b_bound
    b_eval := n100k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n100k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 100 ∧ c.k = 8 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n100k8Data, rfl, rfl, n100k8PBase, n100k8RBase, n100k8BBase, n100k8_valid⟩



