private noncomputable def n85k32PBase : Int := 2 ^ 598
private noncomputable def n85k32RBase : Int := 2 ^ 1282
private noncomputable def n85k32BBase : Int := 2 ^ 1738

private theorem n85k32_p_bound :
    KroneckerLite.sumAbs n85k32Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 85 32 <
      n85k32PBase.natAbs := by decide +kernel

private theorem n85k32_p_eval :
    KroneckerLite.intEval n85k32PBase n85k32Data.pCoeffs =
      KroneckerSpline.canonicalEval 85 32 n85k32PBase := by
  decide +kernel

private theorem n85k32_r_bound :
    KroneckerLite.sumAbs n85k32Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 85 32
        n85k32Data.pCoeffs.length (KroneckerLite.sumAbs n85k32Data.pCoeffs) <
      n85k32RBase.natAbs := by decide +kernel

private theorem n85k32_r_eval :
    KroneckerLite.intEval n85k32RBase n85k32Data.rCoeffs =
      KroneckerLite.curvatureEval 85 32 n85k32Data.pCoeffs n85k32RBase := by
  decide +kernel


private theorem n85k32_b_bound :
    KroneckerLite.sumAbs n85k32Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 253 n85k32Data.bernsteinNumerators <
      n85k32BBase.natAbs := by decide +kernel

private theorem n85k32_b_eval :
    KroneckerLite.intEval n85k32BBase n85k32Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n85k32BBase n85k32Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n85k32_valid : KroneckerSpline.Valid n85k32Data n85k32PBase n85k32RBase n85k32BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n85k32_p_bound
    p_eval := n85k32_p_eval
    r_bound := n85k32_r_bound
    r_eval := n85k32_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n85k32_b_bound
    b_eval := n85k32_b_eval
    nonneg := by decide +kernel
  }

public theorem n85k32_exists : ∃ c : KroneckerLite.CellData,
    c.n = 85 ∧ c.k = 32 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n85k32Data, rfl, rfl, n85k32PBase, n85k32RBase, n85k32BBase, n85k32_valid⟩



end ENT.Pilot.KroneckerSplineData
