private noncomputable def n84k32PBase : Int := 2 ^ 591
private noncomputable def n84k32RBase : Int := 2 ^ 1265
private noncomputable def n84k32BBase : Int := 2 ^ 1716

private theorem n84k32_p_bound :
    KroneckerLite.sumAbs n84k32Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 84 32 <
      n84k32PBase.natAbs := by decide +kernel

private theorem n84k32_p_eval :
    KroneckerLite.intEval n84k32PBase n84k32Data.pCoeffs =
      KroneckerSpline.canonicalEval 84 32 n84k32PBase := by
  decide +kernel

private theorem n84k32_r_bound :
    KroneckerLite.sumAbs n84k32Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 84 32
        n84k32Data.pCoeffs.length (KroneckerLite.sumAbs n84k32Data.pCoeffs) <
      n84k32RBase.natAbs := by decide +kernel

private theorem n84k32_r_eval :
    KroneckerLite.intEval n84k32RBase n84k32Data.rCoeffs =
      KroneckerLite.curvatureEval 84 32 n84k32Data.pCoeffs n84k32RBase := by
  decide +kernel


private theorem n84k32_b_bound :
    KroneckerLite.sumAbs n84k32Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 250 n84k32Data.bernsteinNumerators <
      n84k32BBase.natAbs := by decide +kernel

private theorem n84k32_b_eval :
    KroneckerLite.intEval n84k32BBase n84k32Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n84k32BBase n84k32Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n84k32_valid : KroneckerSpline.Valid n84k32Data n84k32PBase n84k32RBase n84k32BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n84k32_p_bound
    p_eval := n84k32_p_eval
    r_bound := n84k32_r_bound
    r_eval := n84k32_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n84k32_b_bound
    b_eval := n84k32_b_eval
    nonneg := by decide +kernel
  }

public theorem n84k32_exists : ∃ c : KroneckerLite.CellData,
