      KroneckerLite.bernsteinCoeffBound 268 n90k16Data.bernsteinNumerators <
      n90k16BBase.natAbs := by decide +kernel

private theorem n90k16_b_eval :
    KroneckerLite.intEval n90k16BBase n90k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n90k16BBase n90k16Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n90k16_valid : KroneckerSpline.Valid n90k16Data n90k16PBase n90k16RBase n90k16BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n90k16_p_bound
    p_eval := n90k16_p_eval
    r_bound := n90k16_r_bound
    r_eval := n90k16_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n90k16_b_bound
    b_eval := n90k16_b_eval
    nonneg := by decide +kernel
  }

public theorem n90k16_exists : ∃ c : KroneckerLite.CellData,
    c.n = 90 ∧ c.k = 16 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n90k16Data, rfl, rfl, n90k16PBase, n90k16RBase, n90k16BBase, n90k16_valid⟩



end ENT.Pilot.KroneckerSplineData
