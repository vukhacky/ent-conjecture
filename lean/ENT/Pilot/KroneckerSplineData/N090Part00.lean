    p_eval := n90k8_p_eval
    r_bound := n90k8_r_bound
    r_eval := n90k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n90k8_b_bound
    b_eval := n90k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n90k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 90 ∧ c.k = 8 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n90k8Data, rfl, rfl, n90k8PBase, n90k8RBase, n90k8BBase, n90k8_valid⟩



end ENT.Pilot.KroneckerSplineData
