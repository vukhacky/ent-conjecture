private noncomputable def n85k16PBase : Int := 2 ^ 517
private noncomputable def n85k16RBase : Int := 2 ^ 1085
private noncomputable def n85k16BBase : Int := 2 ^ 1538

private theorem n85k16_p_bound :
    KroneckerLite.sumAbs n85k16Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 85 16 <
      n85k16PBase.natAbs := by decide +kernel

private theorem n85k16_p_eval :
    KroneckerLite.intEval n85k16PBase n85k16Data.pCoeffs =
      KroneckerSpline.canonicalEval 85 16 n85k16PBase := by
  decide +kernel

private theorem n85k16_r_bound :
    KroneckerLite.sumAbs n85k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 85 16
        n85k16Data.pCoeffs.length (KroneckerLite.sumAbs n85k16Data.pCoeffs) <
      n85k16RBase.natAbs := by decide +kernel

private theorem n85k16_r_eval :
    KroneckerLite.intEval n85k16RBase n85k16Data.rCoeffs =
      KroneckerLite.curvatureEval 85 16 n85k16Data.pCoeffs n85k16RBase := by
  decide +kernel


private theorem n85k16_b_bound :
    KroneckerLite.sumAbs n85k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 253 n85k16Data.bernsteinNumerators <
      n85k16BBase.natAbs := by decide +kernel

private theorem n85k16_b_eval :
    KroneckerLite.intEval n85k16BBase n85k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n85k16BBase n85k16Data.bernsteinNumerators).2 := by
  decide +kernel


