      (KroneckerLite.bernsteinEvalPair n97k32BBase n97k32Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n97k32_valid : KroneckerSpline.Valid n97k32Data n97k32PBase n97k32RBase n97k32BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n97k32_p_bound
    p_eval := n97k32_p_eval
    r_bound := n97k32_r_bound
    r_eval := n97k32_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n97k32_b_bound
    b_eval := n97k32_b_eval
    nonneg := by decide +kernel
  }

public theorem n97k32_exists : ∃ c : KroneckerLite.CellData,
    c.n = 97 ∧ c.k = 32 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n97k32Data, rfl, rfl, n97k32PBase, n97k32RBase, n97k32BBase, n97k32_valid⟩



end ENT.Pilot.KroneckerSplineData
