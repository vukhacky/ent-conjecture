      KroneckerSpline.canonicalCoeffBound 85 24 <
      n85k24PBase.natAbs := by decide +kernel

private theorem n85k24_p_eval :
    KroneckerLite.intEval n85k24PBase n85k24Data.pCoeffs =
      KroneckerSpline.canonicalEval 85 24 n85k24PBase := by
  decide +kernel

private theorem n85k24_r_bound :
    KroneckerLite.sumAbs n85k24Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 85 24
        n85k24Data.pCoeffs.length (KroneckerLite.sumAbs n85k24Data.pCoeffs) <
      n85k24RBase.natAbs := by decide +kernel

private theorem n85k24_r_eval :
    KroneckerLite.intEval n85k24RBase n85k24Data.rCoeffs =
      KroneckerLite.curvatureEval 85 24 n85k24Data.pCoeffs n85k24RBase := by
  decide +kernel


private theorem n85k24_b_bound :
    KroneckerLite.sumAbs n85k24Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 253 n85k24Data.bernsteinNumerators <
      n85k24BBase.natAbs := by decide +kernel

private theorem n85k24_b_eval :
    KroneckerLite.intEval n85k24BBase n85k24Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n85k24BBase n85k24Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n85k24_valid : KroneckerSpline.Valid n85k24Data n85k24PBase n85k24RBase n85k24BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n85k24_p_bound
    p_eval := n85k24_p_eval
    r_bound := n85k24_r_bound
    r_eval := n85k24_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n85k24_b_bound
    b_eval := n85k24_b_eval
    nonneg := by decide +kernel
  }

public theorem n85k24_exists : ∃ c : KroneckerLite.CellData,
    c.n = 85 ∧ c.k = 24 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n85k24Data, rfl, rfl, n85k24PBase, n85k24RBase, n85k24BBase, n85k24_valid⟩



end ENT.Pilot.KroneckerSplineData
