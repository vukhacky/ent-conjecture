private theorem n97k48_r_eval :
    KroneckerLite.intEval n97k48RBase n97k48Data.rCoeffs =
      KroneckerLite.curvatureEval 97 48 n97k48Data.pCoeffs n97k48RBase := by
  decide +kernel


private theorem n97k48_b_bound :
    KroneckerLite.sumAbs n97k48Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 289 n97k48Data.bernsteinNumerators <
      n97k48BBase.natAbs := by decide +kernel

