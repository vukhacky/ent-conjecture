private theorem n97k48_p_bound :
    KroneckerLite.sumAbs n97k48Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 97 48 <
      n97k48PBase.natAbs := by decide +kernel

private theorem n97k48_p_eval :
    KroneckerLite.intEval n97k48PBase n97k48Data.pCoeffs =
      KroneckerSpline.canonicalEval 97 48 n97k48PBase := by
  decide +kernel

private theorem n97k48_r_bound :
    KroneckerLite.sumAbs n97k48Data.rCoeffs +
