private noncomputable def n89k8PBase : Int := 2 ^ 460
private noncomputable def n89k8RBase : Int := 2 ^ 894
private noncomputable def n89k8BBase : Int := 2 ^ 1363

private theorem n89k8_p_bound :
    KroneckerLite.sumAbs n89k8Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 89 8 <
      n89k8PBase.natAbs := by decide +kernel

private theorem n89k8_p_eval :
    KroneckerLite.intEval n89k8PBase n89k8Data.pCoeffs =
      KroneckerSpline.canonicalEval 89 8 n89k8PBase := by
  decide +kernel

private theorem n89k8_r_bound :
    KroneckerLite.sumAbs n89k8Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 89 8
        n89k8Data.pCoeffs.length (KroneckerLite.sumAbs n89k8Data.pCoeffs) <
      n89k8RBase.natAbs := by decide +kernel

private theorem n89k8_r_eval :
    KroneckerLite.intEval n89k8RBase n89k8Data.rCoeffs =
      KroneckerLite.curvatureEval 89 8 n89k8Data.pCoeffs n89k8RBase := by
  decide +kernel


private theorem n89k8_b_bound :
    KroneckerLite.sumAbs n89k8Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 265 n89k8Data.bernsteinNumerators <
      n89k8BBase.natAbs := by decide +kernel

private theorem n89k8_b_eval :
    KroneckerLite.intEval n89k8BBase n89k8Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n89k8BBase n89k8Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n89k8_valid : KroneckerSpline.Valid n89k8Data n89k8PBase n89k8RBase n89k8BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n89k8_p_bound
    p_eval := n89k8_p_eval
    r_bound := n89k8_r_bound
    r_eval := n89k8_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n89k8_b_bound
    b_eval := n89k8_b_eval
    nonneg := by decide +kernel
  }

public theorem n89k8_exists : ∃ c : KroneckerLite.CellData,
    c.n = 89 ∧ c.k = 8 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n89k8Data, rfl, rfl, n89k8PBase, n89k8RBase, n89k8BBase, n89k8_valid⟩



end ENT.Pilot.KroneckerSplineData
