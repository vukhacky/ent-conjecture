private noncomputable def n100k16PBase : Int := 2 ^ 608
private noncomputable def n100k16RBase : Int := 2 ^ 1272
private noncomputable def n100k16BBase : Int := 2 ^ 1812

private theorem n100k16_p_bound :
    KroneckerLite.sumAbs n100k16Data.pCoeffs +
      KroneckerSpline.canonicalCoeffBound 100 16 <
      n100k16PBase.natAbs := by decide +kernel

private theorem n100k16_p_eval :
    KroneckerLite.intEval n100k16PBase n100k16Data.pCoeffs =
      KroneckerSpline.canonicalEval 100 16 n100k16PBase := by
  decide +kernel

private theorem n100k16_r_bound :
    KroneckerLite.sumAbs n100k16Data.rCoeffs +
      KroneckerLite.curvatureCoeffBound 100 16
        n100k16Data.pCoeffs.length (KroneckerLite.sumAbs n100k16Data.pCoeffs) <
      n100k16RBase.natAbs := by decide +kernel

private theorem n100k16_r_eval :
    KroneckerLite.intEval n100k16RBase n100k16Data.rCoeffs =
      KroneckerLite.curvatureEval 100 16 n100k16Data.pCoeffs n100k16RBase := by
  decide +kernel


private theorem n100k16_b_bound :
    KroneckerLite.sumAbs n100k16Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 298 n100k16Data.bernsteinNumerators <
      n100k16BBase.natAbs := by decide +kernel

private theorem n100k16_b_eval :
    KroneckerLite.intEval n100k16BBase n100k16Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n100k16BBase n100k16Data.bernsteinNumerators).2 := by
  decide +kernel


