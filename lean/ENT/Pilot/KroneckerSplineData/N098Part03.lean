private theorem n98k32_b_eval :
    KroneckerLite.intEval n98k32BBase n98k32Data.transformedCoeffs =
      (KroneckerLite.bernsteinEvalPair n98k32BBase n98k32Data.bernsteinNumerators).2 := by
  decide +kernel


private theorem n98k32_valid : KroneckerSpline.Valid n98k32Data n98k32PBase n98k32RBase n98k32BBase := by
  refine {
    n_lower := by decide +kernel
    n_upper := by decide +kernel
    cell := by decide +kernel
    half := by decide +kernel
    degree := by decide +kernel
    r_length := by decide +kernel
    p_length := by decide +kernel
    p_bound := n98k32_p_bound
    p_eval := n98k32_p_eval
    r_bound := n98k32_r_bound
    r_eval := n98k32_r_eval
    transform := by decide +kernel
    b_length := by decide +kernel
    b_bound := n98k32_b_bound
    b_eval := n98k32_b_eval
    nonneg := by decide +kernel
  }

public theorem n98k32_exists : ∃ c : KroneckerLite.CellData,
    c.n = 98 ∧ c.k = 32 ∧
      ∃ pBase rBase bBase : Int, KroneckerSpline.Valid c pBase rBase bBase :=
  ⟨n98k32Data, rfl, rfl, n98k32PBase, n98k32RBase, n98k32BBase, n98k32_valid⟩



end ENT.Pilot.KroneckerSplineData
