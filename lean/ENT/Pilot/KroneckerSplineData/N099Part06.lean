    KroneckerLite.intEval n99k49RBase n99k49Data.rCoeffs =
      KroneckerLite.curvatureEval 99 49 n99k49Data.pCoeffs n99k49RBase := by
  decide +kernel


private theorem n99k49_b_bound :
    KroneckerLite.sumAbs n99k49Data.transformedCoeffs +
      KroneckerLite.bernsteinCoeffBound 295 n99k49Data.bernsteinNumerators <
      n99k49BBase.natAbs := by decide +kernel

