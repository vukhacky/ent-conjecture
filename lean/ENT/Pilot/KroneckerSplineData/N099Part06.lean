private theorem n99k49_p_eval :
    KroneckerLite.intEval n99k49PBase n99k49Data.pCoeffs =
      KroneckerSpline.canonicalEval 99 49 n99k49PBase := by
  decide +kernel

private theorem n99k49_r_bound :
    KroneckerLite.sumAbs n99k49Data.rCoeffs +
