module

public import ENT.Basic.Exchangeability
public import ENT.Small.LocalGeometry
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

/-! Conditional expectations with respect to the sigma algebra generated by the diagonal projection. -/

@[expose] public section
set_option autoImplicit false
open MeasureTheory Set
open scoped BigOperators ENNReal

namespace ENT.Small
noncomputable section

def diagonalSigma (n : ℕ) : MeasurableSpace (Fin n → ℝ) :=
  MeasurableSpace.comap (projection (diagonal n)) inferInstance

theorem diagonalSigma_le (n : ℕ) :
    diagonalSigma n ≤ (inferInstance : MeasurableSpace (Fin n → ℝ)) :=
  (measurable_projection (diagonal n)).comap_le

theorem integrable_cube_projection {n : ℕ} (b : Fin n → ℝ) :
    Integrable (projection b) (cubeLaw n) := by
  apply Integrable.of_bound (measurable_projection b).aestronglyMeasurable (projectionRadius b)
  exact (cubeLaw_ae_mem n).mono fun x hx => by
    simpa only [Real.norm_eq_abs] using abs_projection_le_radius b x hx

theorem integrable_cube_projection_sq {n : ℕ} (b : Fin n → ℝ) :
    Integrable (fun x => projection b x ^ 2) (cubeLaw n) := by
  apply Integrable.of_bound ((measurable_projection b).pow_const 2).aestronglyMeasurable
    ((projectionRadius b)^2)
  exact (cubeLaw_ae_mem n).mono fun x hx => by
    simpa only [Real.norm_eq_abs, abs_pow] using
      pow_le_pow_left₀ (abs_nonneg (projection b x)) (abs_projection_le_radius b x hx) 2

theorem conditional_mean_zero {n : ℕ} (hn : 0 < n)
    (b : Fin n → ℝ) (hb : ∑ i, b i = 0) :
    (cubeLaw n)[projection b | diagonalSigma n] =ᵐ[cubeLaw n] (fun _ => 0) := by
  symm
  apply ae_eq_condExp_of_forall_setIntegral_eq (diagonalSigma_le n)
    (integrable_cube_projection b)
  · intro s hs hfin
    exact (integrable_const (0:ℝ)).integrableOn
  · intro s hs hfin
    obtain ⟨t, ht, rfl⟩ := hs
    have htest : Integrable
        (fun x => t.indicator (fun _ : ℝ => (1:ℝ)) (projection (diagonal n) x)) (cubeLaw n) := by
      convert (integrable_const (μ := cubeLaw n) (1:ℝ)).indicator
        (ht.preimage (measurable_projection (diagonal n))) using 1
      funext x
      rfl
    have h := integral_zero_sum_projection_diagonal_test hn b hb htest
    rw [integral_zero]
    rw [← integral_indicator (ht.preimage (measurable_projection (diagonal n)))]
    symm
    convert h using 1
    congr 1
    funext x
    by_cases hx : projection (diagonal n) x ∈ t <;> simp [indicator_apply, hx]
  · exact stronglyMeasurable_const.aestronglyMeasurable

theorem projection_support_distance_ae {n : ℕ} (hn : 0 < n)
    (b : Fin n → ℝ) (hb : ∑ i, b i = 0) {γ : ℝ}
    (hγ : ∀ i, Real.sqrt (n:ℝ) * |b i| ≤ γ) :
    ∀ᵐ x ∂cubeLaw n, |projection b x| ≤
      γ * (Real.sqrt (n:ℝ) - |projection (diagonal n) x|) :=
  (cubeLaw_ae_mem n).mono fun x hx => projection_zero_sum_support_distance hn b x hb hx hγ

end
end ENT.Small

namespace ENT.Historical
noncomputable section

/-- Conditional order characterized by integrals over the conditioning sigma
algebra. Integrability is explicit on both sides. -/
theorem condExp_le_of_setIntegral_le {Ω : Type*} {m m₀ : MeasurableSpace Ω}
    {μ : @Measure Ω m₀} (hm : m ≤ m₀) [SigmaFinite (μ.trim hm)]
    {f g : Ω → ℝ} (hf : Integrable f μ) (hg : Integrable g μ)
    (hgm : StronglyMeasurable[m] g)
    (h : ∀ s, MeasurableSet[m] s → μ s < ∞ →
      (∫ x in s, f x ∂μ) ≤ ∫ x in s, g x ∂μ) :
    μ[f | m] ≤ᵐ[μ] g := by
  apply ae_of_ae_trim hm
  apply ae_le_of_forall_setIntegral_le
    (integrable_condExp.trim hm stronglyMeasurable_condExp) (hg.trim hm hgm)
  intro s hs hfin
  rw [← setIntegral_trim hm stronglyMeasurable_condExp hs, ← setIntegral_trim hm hgm hs,
    setIntegral_condExp hm hf hs]
  apply h s hs
  simpa only [trim_measurableSet_eq hm hs] using hfin

end
end ENT.Historical
