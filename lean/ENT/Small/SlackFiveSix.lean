open MeasureTheory Set
namespace ENT.Small
noncomputable section
open ENT.Comparison
def logZW6Certificate : Enclosures.LogPointCertificate := {
  argument := (128668869/50000000:ℚ)
  shift := 0
  ratio := (78668869/178668869:ℚ)
  lower := (4726095959/5000000000:ℚ)
  upper := (94521919181/100000000000:ℚ)
}

theorem logZW6Certificate_valid : logZW6Certificate.Valid := by decide +kernel

theorem log_partitionFunction_W6_upper : Real.log (partitionFunction W6) ≤ (94521919181/100000000000:ℝ) := by
  have h := Real.log_le_log (partitionFunction_pos W6_exp_integrable) partitionFunction_W6_upper
  have hc := (logZW6Certificate.sound logZW6Certificate_valid).2
  norm_num only [logZW6Certificate,Rat.cast_div,Rat.cast_ofNat] at hc
  exact h.trans hc

theorem W6_diagonal_expectation :
    (∫x,W6 x ∂varianceOneProjectionLaw (diagonal 6)) = (124071403/262500000:ℝ) := by
  unfold W6
  rw [octicPolynomial_expectation _ (isUnit_diagonal (by decide))]
  have hdiag : (fun i : Fin 6 => (diagonal 6 i)^2) = flatWeights 6 := funext (diagonal_sq 6)
  rw [hdiag]
  norm_num [octicWeightExpression,powerSum,flatWeights,Fin.sum_univ_succ]

theorem sigma6_lt : sigma6 < (7/5000000:ℝ) := by
  rw [sigma6,diagonalApproximationDefect_formula,W6_diagonal_expectation]
  linarith [log_partitionFunction_W6_upper,varianceOne_diagonal_entropy_six_lower]

end
end ENT.Small
