  norm_num only [logZW5Certificate,Rat.cast_div,Rat.cast_ofNat] at hc
  exact h.trans hc

theorem W5_diagonal_expectation :
    (∫x,W5 x ∂varianceOneProjectionLaw (diagonal 5)) = (101963319163/218750000000:ℝ) := by
  unfold W5
  rw [octicPolynomial_expectation _ (isUnit_diagonal (by decide))]
  have hdiag : (fun i : Fin 5 => (diagonal 5 i)^2) = flatWeights 5 := funext (diagonal_sq 5)
  rw [hdiag]
  norm_num [octicWeightExpression,powerSum,flatWeights,Fin.sum_univ_succ]

theorem sigma5_lt : sigma5 < (1/200000:ℝ) := by
  rw [sigma5,diagonalApproximationDefect_formula,W5_diagonal_expectation]
  linarith [log_partitionFunction_W5_upper,varianceOne_diagonal_entropy_five_lower]

end
