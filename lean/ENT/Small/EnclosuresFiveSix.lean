private theorem Kappa6Cell009_setup_check :
    0 ≤ Kappa6Cell009.a ∧
    Kappa6Cell009.a ≤ Kappa6Cell009.b ∧
    0 ≤ Kappa6Cell009.radius ∧
    Kappa6Cell009.radius < 1 ∧
    0 < Kappa6Cell009.densityDenominator ∧
    0 < Kappa6Cell009.weightDenominator ∧
    0 < Kappa6Cell009.centerNumerator ∧
    0 < Kappa6Cell009.centerDenominator ∧
    0 < Kappa6Cell009.logDenominator ∧
    Kappa6Cell009.logPoint.Valid ∧
    Kappa6Cell009.logPoint.argument = Kappa6Cell009.center ∧
    Kappa6Cell009.logCenter - Kappa6Cell009.logError ≤ Kappa6Cell009.logPoint.lower ∧
    Kappa6Cell009.logPoint.upper ≤ Kappa6Cell009.logCenter + Kappa6Cell009.logError ∧
    0 < (polynomialBounds Kappa6Cell009.densityCoeffs Kappa6Cell009.a Kappa6Cell009.b).1 / (Kappa6Cell009.densityDenominator:ℚ) ∧
    1-Kappa6Cell009.radius ≤ ((polynomialBounds Kappa6Cell009.densityCoeffs Kappa6Cell009.a Kappa6Cell009.b).1 /
    (Kappa6Cell009.densityDenominator:ℚ))/Kappa6Cell009.center ∧
    ((polynomialBounds Kappa6Cell009.densityCoeffs Kappa6Cell009.a Kappa6Cell009.b).2 /
    (Kappa6Cell009.densityDenominator:ℚ))/Kappa6Cell009.center ≤ 1+Kappa6Cell009.radius ∧
    -Kappa6Cell009.weightBound ≤ (polynomialBounds Kappa6Cell009.weightCoeffs Kappa6Cell009.a Kappa6Cell009.b).1 / (Kappa6Cell009.weightDenominator:ℚ) ∧
    (polynomialBounds Kappa6Cell009.weightCoeffs Kappa6Cell009.a Kappa6Cell009.b).2 / (Kappa6Cell009.weightDenominator:ℚ) ≤ Kappa6Cell009.weightBound := by decide +kernel

private theorem Kappa6Cell009_argument_check :
    Kappa6Cell009.argumentCoeffs = Dense.add (Dense.scale Kappa6Cell009.centerDenominator Kappa6Cell009.densityCoeffs)
    [-Kappa6Cell009.argumentDenominator] := by decide +kernel

private theorem Kappa6Cell009_taylor_check :
    Kappa6Cell009.integrandCoeffs = weightedLogPoly Kappa6Cell009.weightCoeffs Kappa6Cell009.argumentCoeffs
    Kappa6Cell009.argumentDenominator Kappa6Cell009.logNumerator Kappa6Cell009.logDenominator := by decide +kernel

private theorem Kappa6Cell009_primitive_check :
    0 < Kappa6Cell009.primitiveDenominator ∧
    Dense.derivative Kappa6Cell009.primitiveCoeffs = Dense.scale Kappa6Cell009.primitiveDenominator Kappa6Cell009.integrandCoeffs := by decide +kernel

private theorem Kappa6Cell009_integral_check :
    Kappa6Cell009.integralValue = (evalRat Kappa6Cell009.primitiveCoeffs Kappa6Cell009.b - evalRat Kappa6Cell009.primitiveCoeffs Kappa6Cell009.a) /
    (Kappa6Cell009.primitiveDenominator:ℚ)/(Kappa6Cell009.integrandDenominator:ℚ) := by decide +kernel

private theorem Kappa6Cell009_slack_check :
    Kappa6Cell009.lower ≤ Kappa6Cell009.integralValue - (Kappa6Cell009.b-Kappa6Cell009.a)*Kappa6Cell009.weightBound*(Kappa6Cell009.logError+ratLogError 16 Kappa6Cell009.radius) ∧
    Kappa6Cell009.integralValue + (Kappa6Cell009.b-Kappa6Cell009.a)*Kappa6Cell009.weightBound*(Kappa6Cell009.logError+ratLogError 16 Kappa6Cell009.radius) ≤ Kappa6Cell009.upper := by decide +kernel

private theorem Kappa6Cell009_valid : Kappa6Cell009.Valid := by
  rcases Kappa6Cell009_setup_check with ⟨h0,h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11,h12,h13,h14,h15,h16,h17⟩
  rcases Kappa6Cell009_primitive_check with ⟨h20,h21⟩
  rcases Kappa6Cell009_slack_check with ⟨h23,h24⟩
  exact ⟨h0,h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11,h12,h13,h14,h15,h16,h17,Kappa6Cell009_argument_check,Kappa6Cell009_taylor_check,h20,h21,Kappa6Cell009_integral_check,h23,h24⟩

